{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samuraix-arcade",
  "main": "./worker.js",
  "compatibility_date": "2026-04-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  },
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://pub-2c5587529e4249efbcf882d5d3697d95.r2.dev",
    "NETPLAY_SERVER_URL": "",
    "NETPLAY_ICE_SERVERS_JSON": "[{\"urls\":\"stun:stun.l.google.com:19302\"},{\"urls\":\"stun:stun1.l.google.com:19302\"},{\"urls\":\"stun:stun2.l.google.com:19302\"}]"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MULTIPLAYER_ROOMS",
        "class_name": "ArcadeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-multiplayer-rooms",
      "new_sqlite_classes": [
        "ArcadeRoom"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
